{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Renakoni/awesome-dsh-themes/schemas/theme.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "author", "description", "package", "rowId", "version", "source", "compatibility", "license"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "package": { "type": "string", "minLength": 1 },
    "rowId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository"],
      "properties": {
        "kind": { "const": "external" },
        "repository": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "subpath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" }
      }
    },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["light", "dark"] } },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dsh", "platform"],
      "properties": {
        "dsh": { "type": "string", "minLength": 1 },
        "platform": { "type": "array", "contains": { "const": "web" }, "items": { "type": "string" } }
      }
    },
    "screenshots": { "type": "array", "items": { "type": "string", "pattern": "^(?:https://|[A-Za-z0-9._/-]+$)" }, "uniqueItems": true },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility", "preview", "installation"],
      "properties": {
        "compatibility": { "enum": ["verified", "unverified"] },
        "preview": { "enum": ["verified", "repository-card"] },
        "installation": { "enum": ["verified", "manual-only"] }
      }
    },
    "updatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "commercialUse"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "commercialUse": { "type": "boolean" },
        "notice": { "type": "string", "minLength": 1 }
      }
    }
  }
}
