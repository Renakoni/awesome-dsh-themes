{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Renakoni/dsh-appearance-catalog/schemas/theme.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "author", "description", "package", "rowId", "version", "source", "compatibility", "screenshots", "license"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "homepage": { "type": "string", "pattern": "^https://" },
    "package": { "type": "string", "minLength": 1 },
    "rowId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "commit"],
          "properties": {
            "kind": { "const": "external" },
            "repository": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$" },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "subpath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "bundled" },
            "path": { "type": "string", "pattern": "^themes/[a-z0-9][a-z0-9._-]*(?:/[A-Za-z0-9._-]+)*$" },
            "repository": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$" },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        }
      ]
    },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["light", "dark"] } },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dsh", "platform"],
      "properties": {
        "dsh": { "type": "string", "minLength": 1 },
        "platform": { "type": "array", "contains": { "const": "web" }, "items": { "type": "string" } }
      }
    },
    "screenshots": { "type": "array", "items": { "type": "string", "pattern": "^(?:https://|[A-Za-z0-9._/-]+$)" }, "uniqueItems": true },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "commercialUse"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "commercialUse": { "type": "boolean" },
        "notice": { "type": "string", "minLength": 1 }
      }
    }
  }
}
